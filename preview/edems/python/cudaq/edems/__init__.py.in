"""GF2/EDEM packaging scaffold. The mathematical API is not implemented yet."""

from pathlib import Path

from . import _scaffold


def get_install_prefix() -> str:
    """Return the libraries' installation prefix for CMAKE_PREFIX_PATH.

    The prefix contains lib/, include/, and lib/cmake/ for both libraries.
    """
    prefix = Path(__file__).resolve().parent
    return str((prefix / "@CUDAQ_EDEMS_INSTALL_RELATIVE_PREFIX@").resolve())


__all__ = ["_scaffold", "get_install_prefix"]
